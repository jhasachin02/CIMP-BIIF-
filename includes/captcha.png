<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 45" width="160" height="45">
  <rect width="160" height="45" fill="#e2e8f0" rx="6"/>
  <!-- Distortion lines -->
  <line x1="5" y1="12" x2="155" y2="35" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3,3"/>
  <line x1="10" y1="38" x2="150" y2="8" stroke="#cbd5e1" stroke-width="2"/>
  <line x1="20" y1="22" x2="140" y2="25" stroke="#94a3b8" stroke-width="1"/>
  <!-- Captcha characters -->
  <text x="22" y="32" font-family="'Courier New', monospace" font-size="26" font-weight="bold" fill="#1e3a8a" transform="rotate(-5 22,32)">7</text>
  <text x="45" y="30" font-family="'Courier New', monospace" font-size="24" font-weight="bold" fill="#0369a1" transform="rotate(8 45,30)">W</text>
  <text x="70" y="33" font-family="'Courier New', monospace" font-size="25" font-weight="bold" fill="#b91c1c" transform="rotate(-6 70,33)">9</text>
  <text x="95" y="29" font-family="'Courier New', monospace" font-size="24" font-weight="bold" fill="#15803d" transform="rotate(7 95,29)">X</text>
  <text x="120" y="32" font-family="'Courier New', monospace" font-size="26" font-weight="bold" fill="#7c3aed" transform="rotate(-4 120,32)">4</text>
</svg>
