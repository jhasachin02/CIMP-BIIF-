# ----------------------------------------------------------------------
# CIMP-BIIF Official Portal - Clean URL Rewrite Rules
# Removes .html extensions and serves clean URLs
# ----------------------------------------------------------------------

RewriteEngine On

# 1. Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /.*index\.html\ HTTP/ [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L,NC]

# 2. Redirect /page.html to /page for browser URL bar
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP/ [NC]
RewriteRule ^ /%1 [R=301,L,NC]

# 3. Internally rewrite /page to /page.html if the html file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L,QSA]

# 4. Fallback for nested directory index
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]
